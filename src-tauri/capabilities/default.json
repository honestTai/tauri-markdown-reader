{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "FlowMark 默认权限：仅允许 shell 插件启动 sidecar，不允许任意命令执行",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    {
      "identifier": "shell:allow-spawn",
      "allow": []
    }
  ]
}
